__id__ = "tpl.singlefile"
__name__ = "Single-file template"
__description__ = "Legacy mobile *.plugin single-file style (no plugin.json needed)"
__author__ = "@you"
__version__ = "1.0"

try:
    from ayugram_compat.hook_utils import hook
    from ayugram_compat.android_utils import toast
except ImportError:
    from ayu_api import hook, toast


@hook("on_message_sending")
def shout(ctx):
    if isinstance(ctx, dict):
        msg = ctx.get("message") or {}
        text = msg.get("text", "") if isinstance(msg, dict) else ""
    else:
        text = getattr(getattr(ctx, "message", None), "text", "") or ""
    if text.startswith("/shout ") and len(text) > 7:
        upper = text[7:].upper()
        if isinstance(ctx, dict):
            ctx["rewrite"] = True
            ctx["rewritten_text"] = upper
            ctx["rewrittenText"] = upper
        else:
            ctx.rewrite = True
            ctx.rewrittenText = upper
        toast("shouted")


def on_unload():
    try:
        toast("single-file unloaded")
    except Exception:
        pass
